{
  "name": "ActionFlow AI - Document Processing Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "actionflow-extract",
        "responseMode": "lastNode",
        "responseData": "allEntries"
      },
      "name": "Document Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "url": "http://localhost:4002/api/extract",
        "jsonParameters": true,
        "bodyParametersJson": "{
          \"source_text\": \"={{ $json.text }}\",
          \"processing_consent\": true,
          \"source_type\": \"upload\"
        }"
      },
      "name": "Send to ActionFlow API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [460, 100]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": \"={{ $json.actions.length > 0 }}\",
              "operation": \"equals\",
              \"value2\": \"true\"
            }
          ]
        },
        "options": {
          "failOnError": false
        }
      },
      "name": "Has Actions?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [640, 100]
    },
    {
      "parameters": {
        "to": "reviewer@example.com",
        "subject": "ActionFlow AI: New Actions Require Review",
        "text": "New document processed:\\n\\nSummary: {{ $json.summary }}\\nActions: {{ $json.actions.length }}\\nParties: {{ $json.parties.join(', ') }}\\n\\nPlease review in ActionFlow dashboard."
      },
      "name": "Notify Reviewer",
      "type": "n8n-nodes-base.sendEmail",
      "typeVersion": 1,
      "position": [840, 100],
      "credentials": {
        "smtp": "smtp-credentials"
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "url": "https://api.openrouter.ai/v1/chat/completions",
        "jsonParameters": true,
        "bodyParametersJson": "{
          \"model\": \"openrouter/auto\",
          \"messages\": [
            {
              \"role\": \"user\",
              \"content\": \"Summarize and extract key dates from: {{ $json.actions }}\"
            }
          ]
        }"
      },
      "name": "AI Summarization",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [840, -100],
      "credentials": {
        "headerAuth": "openrouter-api-key"
      }
    }
  ],
  "connections": {
    "Document Webhook": {
      "main": [
        [
          {
            "node": "Send to ActionFlow API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to ActionFlow API": {
      "main": [
        [
          {
            "node": "Has Actions?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Actions?": {
      "main": [
        [
          {
            "node": "Notify Reviewer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "AI Summarization",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1",
  "triggerCount": 0,
  "updatedAt": "2026-11-13T00:00:00Z",
  "createdAt": "2026-11-12T00:00:00Z",
  "versionId": "1"
}
